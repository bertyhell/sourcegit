<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SourceGit.Views.MergeConflictEditorView"
             x:DataType="vm:MergeConflictEditor"
             x:Name="ThisControl">
  <UserControl.Styles>
    <Style Selector="Border.branch_badge">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.branch_badge:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="32,*,32">
    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="8,0" Background="{DynamicResource Brush.ToolBar}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.File}"/>

        <TextBlock Grid.Column="1"
                   Margin="8"
                   Text="{Binding FilePath}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <ToggleButton Grid.Column="2"
                      x:Name="CollapseUnchangedToggle"
                      Classes="line_path"
                      Width="32"
                      ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.CollapseUnchanged}"
                      IsCheckedChanged="OnCollapseUnchangedChanged">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Lines.All}" Margin="0,3,0,0"/>
        </ToggleButton>

        <Button Grid.Column="3"
                Classes="icon_button"
                Width="32"
                Click="OnGotoLine">
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.GotoLine}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+G, macOS=⌘+G}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
          <TextBlock Text="Ln" FontSize="10" FontFamily="{DynamicResource Fonts.Monospace}" Margin="0,2,0,0"/>
        </Button>

        <Button Grid.Column="4"
                Classes="icon_button"
                Width="32"
                Click="OnOpenExternalMergeTool"
                ToolTip.Tip="{DynamicResource Text.WorkingCopy.Conflicts.MergeExternal}">
          <Path Width="13" Height="13" Data="{StaticResource Icons.OpenWith}"/>
        </Button>

        <Button Grid.Column="5"
                Classes="icon_button"
                Width="32"
                Click="OnPopOut"
                IsVisible="{Binding #ThisControl.IsEmbedded}"
                ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.OpenInWindow}">
          <Path Width="13" Height="13" Data="{StaticResource Icons.OpenAsStandalone}"/>
        </Button>
      </Grid>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Row="1" RowDefinitions="*,28,*" ColumnDefinitions="*,20">
      <!-- Mine and Theirs Panels (Side-by-Side) -->
      <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,*" Margin="4,4,4,0">
        <!-- Mine (Ours) Panel -->
        <Border Grid.Column="0" Margin="0,0,2,0">
          <Grid RowDefinitions="26,*">
            <Border Grid.Row="0" Padding="6,0" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Classes="branch_badge"
                        Tag="{Binding Mine}"
                        PointerPressed="OnBranchBadgePressed">
                  <ToolTip.Tip>
                    <ContentControl Content="{Binding Mine}">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="m:Commit">
                          <StackPanel Orientation="Vertical" Spacing="2">
                            <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" Foreground="DarkOrange" Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"/>
                            <TextBlock Text="{Binding Subject}"/>
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="x:String">
                          <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                  </ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="10" Height="10" Data="{StaticResource Icons.Check}" Fill="{DynamicResource Brush.FG1}"/>
                    <TextBlock Text="{Binding MineName}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>

                <TextBlock Grid.Column="1"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.FG2}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding MineSubject}"/>

                <Button Grid.Column="2"
                        Classes="flat"
                        Height="20"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Command="{Binding ResolveAllUnsolved}"
                        CommandParameter="{x:Static m:ConflictResolution.UseOurs}"
                        IsEnabled="{Binding UnsolvedCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}, Mode=OneWay}"
                        ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.ResolveAll.UseMine}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="10" Height="10" Data="{StaticResource Icons.Check}"/>
                    <TextBlock Text="{DynamicResource Text.MergeConflictEditor.TakeAll}" FontSize="11"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Background="{DynamicResource Brush.Contents}">
              <v:MergeConflictTextPresenter x:Name="OursPresenter"
                                            PanelType="Ours"
                                            Lines="{Binding OursLines, Mode=OneWay}"
                                            MaxLineNumber="{Binding MaxLineNumber}"
                                            FileName="{Binding FilePath}"
                                            SelectedChunk="{Binding SelectedChunk}"
                                            FontFamily="{DynamicResource Fonts.Monospace}"
                                            TheirsContentBackground="{DynamicResource Brush.Conflict.TheirsBG}"
                                            OursContentBackground="{DynamicResource Brush.Conflict.MineBG}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border2}"/>
              <Border x:Name="MinePopup"
                      IsVisible="False"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right"
                      Background="{DynamicResource Brush.ToolBar}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="4,2"
                      BoxShadow="0 2 8 0 #40000000">
                <Button Classes="flat primary"
                        Content="{DynamicResource Text.MergeConflictEditor.UseMine}"
                        Command="{Binding Resolve}"
                        CommandParameter="{x:Static m:ConflictResolution.UseOurs}"/>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <!-- Theirs Panel -->
        <Border Grid.Column="1" Margin="2,0,0,0">
          <Grid RowDefinitions="26,*">
            <Border Grid.Row="0" Padding="6,0" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Classes="branch_badge"
                        Tag="{Binding Theirs}"
                        PointerPressed="OnBranchBadgePressed">
                  <ToolTip.Tip>
                    <ContentControl Content="{Binding Theirs}">
                      <ContentControl.DataTemplates>
                        <DataTemplate DataType="m:Commit">
                          <StackPanel Orientation="Vertical" Spacing="2">
                            <TextBlock FontFamily="{DynamicResource Fonts.Monospace}" Foreground="DarkOrange" Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"/>
                            <TextBlock Text="{Binding Subject}"/>
                          </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="x:String">
                          <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                      </ContentControl.DataTemplates>
                    </ContentControl>
                  </ToolTip.Tip>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="10" Height="10" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.FG1}"/>
                    <TextBlock Text="{Binding TheirsName}" FontSize="12" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>

                <TextBlock Grid.Column="1"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.FG2}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding TheirsSubject}"/>

                <Button Grid.Column="2"
                        Classes="flat"
                        Height="20"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Command="{Binding ResolveAllUnsolved}"
                        CommandParameter="{x:Static m:ConflictResolution.UseTheirs}"
                        IsEnabled="{Binding UnsolvedCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}, Mode=OneWay}"
                        ToolTip.Tip="{DynamicResource Text.MergeConflictEditor.ResolveAll.UseTheirs}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="10" Height="10" Data="{StaticResource Icons.Check}"/>
                    <TextBlock Text="{DynamicResource Text.MergeConflictEditor.TakeAll}" FontSize="11"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Background="{DynamicResource Brush.Contents}">
              <v:MergeConflictTextPresenter x:Name="TheirsPresenter"
                                            PanelType="Theirs"
                                            Lines="{Binding TheirsLines, Mode=OneWay}"
                                            MaxLineNumber="{Binding MaxLineNumber}"
                                            FileName="{Binding FilePath}"
                                            SelectedChunk="{Binding SelectedChunk}"
                                            FontFamily="{DynamicResource Fonts.Monospace}"
                                            TheirsContentBackground="{DynamicResource Brush.Conflict.TheirsBG}"
                                            OursContentBackground="{DynamicResource Brush.Conflict.MineBG}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border2}"/>
              <Border x:Name="TheirsPopup"
                      IsVisible="False"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Right"
                      Background="{DynamicResource Brush.ToolBar}"
                      BorderBrush="{DynamicResource Brush.Border2}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="4,2"
                      BoxShadow="0 2 8 0 #40000000">
                <Button Classes="flat primary"
                        Content="{DynamicResource Text.MergeConflictEditor.UseTheirs}"
                        Command="{Binding Resolve}"
                        CommandParameter="{x:Static m:ConflictResolution.UseTheirs}"/>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Conflict Navigation -->
      <Border Grid.Row="1" Grid.Column="0" Margin="4,4,4,0" Padding="8,0" Background="{DynamicResource Brush.Popup}" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource Brush.Border2}">
        <Grid>
          <TextBlock Text="{DynamicResource Text.MergeConflictEditor.Result}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <Button Classes="flat"
                    Height="20"
                    Padding="6,0"
                    Click="OnGotoPrevConflict"
                    IsEnabled="{Binding UnsolvedCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}, Mode=OneWay}">
              <ToolTip.Tip>
                <TextBlock>
                  <Run Text="{DynamicResource Text.MergeConflictEditor.PrevConflict}"/>
                  <Run Text=" "/>
                  <Run Text="{OnPlatform Ctrl+Up / Shift+F7, macOS=⌘+Up / ⇧+F7}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
                </TextBlock>
              </ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Path Width="10" Height="10" Margin="0,2,0,0" Data="{StaticResource Icons.Up}"/>
                <TextBlock Text="{DynamicResource Text.MergeConflictEditor.Previous}" FontSize="11"/>
              </StackPanel>
            </Button>

            <TextBlock Text="{Binding NavigationDesc, Mode=OneWay}" VerticalAlignment="Center"/>

            <Button Classes="flat"
                    Height="20"
                    Padding="6,0"
                    Click="OnGotoNextConflict"
                    IsEnabled="{Binding UnsolvedCount, Converter={x:Static c:IntConverters.IsGreaterThanZero}, Mode=OneWay}">
              <ToolTip.Tip>
                <TextBlock>
                  <Run Text="{DynamicResource Text.MergeConflictEditor.NextConflict}"/>
                  <Run Text=" "/>
                  <Run Text="{OnPlatform Ctrl+Down / F7, macOS=⌘+Down / F7}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
                </TextBlock>
              </ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Text.MergeConflictEditor.Next}" FontSize="11"/>
                <Path Width="10" Height="10" Margin="0,2,0,0" Data="{StaticResource Icons.Down}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Result Panel -->
      <Grid Grid.Row="2" Grid.Column="0" Margin="4,0,4,4" Background="{DynamicResource Brush.Contents}">
        <v:MergeConflictTextPresenter x:Name="ResultPresenter"
                                      PanelType="Result"
                                      Document="{Binding ResultDocument, Mode=OneWay}"
                                      MaxLineNumber="{Binding MaxLineNumber}"
                                      FileName="{Binding FilePath}"
                                      SelectedChunk="{Binding SelectedChunk}"
                                      FontFamily="{DynamicResource Fonts.Monospace}"
                                      TheirsContentBackground="{DynamicResource Brush.Conflict.TheirsBG}"
                                      OursContentBackground="{DynamicResource Brush.Conflict.MineBG}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource Brush.Border2}"/>
        <Border x:Name="ResultPopup"
                IsVisible="False"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Background="{DynamicResource Brush.ToolBar}"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4,2"
                BoxShadow="0 2 8 0 #40000000">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="flat primary"
                    Content="{DynamicResource Text.MergeConflictEditor.UseMine}"
                    Command="{Binding Resolve}"
                    CommandParameter="{x:Static m:ConflictResolution.UseOurs}"/>
            <Button Classes="flat primary"
                    Content="{DynamicResource Text.MergeConflictEditor.UseTheirs}"
                    Command="{Binding Resolve}"
                    CommandParameter="{x:Static m:ConflictResolution.UseTheirs}"/>
            <Button Classes="flat primary">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{DynamicResource Text.MergeConflictEditor.UseBoth}" Foreground="White"/>
                <Path Width="12" Height="12" Margin="4,4,0,0" Data="{StaticResource Icons.Down}" Fill="White"/>
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Command="{Binding Resolve}" CommandParameter="{x:Static m:ConflictResolution.UseBothMineFirst}">
                    <MenuItem.Header>
                      <TextBlock Text="{DynamicResource Text.MergeConflictEditor.AcceptBoth.MineFirst}"/>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Command="{Binding Resolve}" CommandParameter="{x:Static m:ConflictResolution.UseBothTheirsFirst}">
                    <MenuItem.Header>
                      <TextBlock Text="{DynamicResource Text.MergeConflictEditor.AcceptBoth.TheirsFirst}"/>
                    </MenuItem.Header>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
        <Border x:Name="ResultUndoPopup"
                IsVisible="False"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Background="{DynamicResource Brush.ToolBar}"
                BorderBrush="{DynamicResource Brush.Border2}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="4,2"
                BoxShadow="0 2 8 0 #40000000">
          <Button Classes="flat"
                  Content="{DynamicResource Text.MergeConflictEditor.Reset}"
                  Command="{Binding Resolve}"
                  CommandParameter="{x:Static m:ConflictResolution.None}"/>
        </Border>
      </Grid>

      <!-- Minimap -->
      <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
              Margin="0,4,4,4"
              BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}">
        <v:MergeConflictMinimap x:Name="Minimap"
                                DisplayRange="{Binding #OursPresenter.DisplayRange, Mode=OneWay}"
                                UnsolvedCount="{Binding UnsolvedCount, Mode=OneWay}"/>
      </Border>

      <v:GotoLineBar x:Name="GotoLineBar"
                     Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
                     IsVisible="False"
                     VerticalAlignment="Top" HorizontalAlignment="Center"
                     Margin="0,4,0,0"
                     Preview="OnGotoLinePreview"
                     Closed="OnGotoLineClosed"/>
    </Grid>

    <!-- Error -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Popup}"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}"
            Padding="16"
            CornerRadius="6"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Effect="drop-shadow(0 0 12 #60000000)"
            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Vertical">
        <Path Width="32" Height="32" Fill="Orange" Data="{StaticResource Icons.Error}"/>
        <TextBlock Text="{Binding Error, Mode=OneWay}"
                   MaxWidth="500"
                   Margin="0,16"
                   TextWrapping="Wrap"/>
        <Button Classes="flat primary"
                MinWidth="80"
                Margin="0"
                HorizontalAlignment="Center"
                Content="{DynamicResource Text.Sure}"
                Command="{Binding ClearErrorMessage}"/>
      </StackPanel>
    </Border>

    <!-- Foot -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="8">
      <Button Classes="flat primary"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Click="OnSaveAndStage"
              IsEnabled="{Binding UnsolvedCount, Converter={x:Static c:IntConverters.IsZero}}">
        <ToolTip.Tip>
          <TextBlock Text="{OnPlatform Ctrl+S, macOS=⌘+S}"/>
        </ToolTip.Tip>
        <TextBlock Text="{DynamicResource Text.MergeConflictEditor.SaveAndStage}"/>
      </Button>

      <Button Classes="flat"
              MinWidth="80"
              Click="OnSecondaryAction"
              HorizontalAlignment="Center">
        <Panel>
          <TextBlock Text="{DynamicResource Text.MergeConflictEditor.DiscardChanges}" IsVisible="{Binding #ThisControl.IsEmbedded}"/>
          <TextBlock Text="{DynamicResource Text.Cancel}" IsVisible="{Binding !#ThisControl.IsEmbedded}"/>
        </Panel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
